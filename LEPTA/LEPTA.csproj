<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LEPTA.Shared\LEPTA.Shared.csproj" />
    <ProjectReference Include="..\LEPTA.vLLM\LEPTA.vLLM.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <PackageReference Include="NLog" Version="6.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\logo_removeBG.ico" />
    <Resource Include="Resources\logo_removeBG.png" />
    <Content Include="Resources\logo.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\logo_removeBG.ico</ApplicationIcon>
    <!-- Default version for local builds; the release workflow overrides this
         from the git tag via -p:Version. AssemblyVersion/FileVersion must be
         four-part, so set them explicitly for local builds too. -->
    <Version>0.0.0-dev</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
  </PropertyGroup>

</Project>
