<UserControl x:Class="LEPTA.Controls.MarkdownResponseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="420">
    <Grid PreviewMouseWheel="Root_PreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="ToolbarPanel" Margin="0,0,0,8" LastChildFill="False">
            <Button x:Name="PreviewResponseButton"
                    DockPanel.Dock="Left"
                    Content="⛶"
                    Width="32"
                    Height="28"
                    Padding="0"
                    FontSize="14"
                    Margin="0,0,8,0"
                    ToolTip="Toggle expanded panel view"
                    AutomationProperties.Name="Preview panel"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button x:Name="OpenChatButton"
                    DockPanel.Dock="Right"
                    Content="💬"
                    Width="32"
                    Height="28"
                    Padding="0"
                    FontSize="14"
                    Margin="0,0,8,0"
                    ToolTip="Continue this response in Chat"
                    AutomationProperties.Name="Open response in chat"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenChatButton_Click" />
            <Button x:Name="CopyResponseButton"
                    DockPanel.Dock="Right"
                    Content="⧉"
                    Width="32"
                    Height="28"
                    Padding="0"
                    FontSize="14"
                    ToolTip="Copy the full response to the clipboard"
                    AutomationProperties.Name="Copy full response"
                    AutomationProperties.HelpText="Copies the full rendered response text to the clipboard."
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CopyResponseButton_Click" />
        </DockPanel>

        <Grid Grid.Row="1">
            <TextBox x:Name="StreamingTextBox"
                     Visibility="Collapsed"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled" />
            <FlowDocumentScrollViewer x:Name="RenderedDocumentViewer"
                                      Visibility="Collapsed"
                                      AutomationProperties.Name="Rendered response"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False"
                                      IsSelectionEnabled="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0" />
        </Grid>
    </Grid>
</UserControl>

