<UserControl x:Class="LEPTA.Controls.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="ChatHistoryColumn" Width="280" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource PanelBackgroundAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="ChatServerCombo"
                                      Width="320"
                                      Height="34"
                                      DisplayMemberPath="Name" />
                            <CheckBox x:Name="ChatThinkingCheckBox"
                                      Content="Thinking"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center" />
                            <Button x:Name="NewChatButton"
                                    Content="New chat"
                                    Height="34"
                                    Padding="14,0"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NewChatButton_Click" />
                            <Button x:Name="StopChatButton"
                                    Content="Stop"
                                    Height="34"
                                    Padding="14,0"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="StopChatButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ChatStatusText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid>
                        <ScrollViewer x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MessagesPanel" />
                        </ScrollViewer>
                        <Border x:Name="ChatEmptyStateBorder"
                                Background="{DynamicResource PanelBackgroundAltBrush}"
                                BorderBrush="{DynamicResource BorderBrushTheme}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                Margin="2"
                                IsHitTestVisible="False">
                            <StackPanel>
                                <TextBlock Text="Chat is ready" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Select a verified server and send a prompt to start." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatInputBox" MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True" PreviewKeyDown="ChatInputBox_PreviewKeyDown" />
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send" Margin="10,4,0,0" Click="SendButton_Click" />
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Enter sends; Shift+Enter adds a newline." />
                </Grid>

                <ProgressBar x:Name="ChatProgress" Height="4" VerticalAlignment="Top" IsIndeterminate="False" />
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Margin="12,0,0,0"
                Style="{StaticResource CardBorderStyle}"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="History" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,12" />
                <ListBox x:Name="ChatHistoryList"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="False"
                         SelectionChanged="ChatHistoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,6,6,6" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Content="✕"
                                            Width="24" Height="24"
                                            Padding="0"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Margin="6,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="DeleteHistoryEntry_Click"
                                            ToolTip="Delete this chat" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{Binding CreatedAt, StringFormat={}{0:MMM dd, HH:mm}}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
