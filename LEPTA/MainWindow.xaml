<Window x:Class="LEPTA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LEPTA.Controls"
        xmlns:sharedModels="clr-namespace:LEPTA.Shared.Diagnostics;assembly=LEPTA.Shared"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="LEPTA" Height="820" Width="1260" MinHeight="720" MinWidth="1080">
    <Grid x:Name="Root" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="NavigationPanel" Background="{DynamicResource PanelBackgroundBrush}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <Button x:Name="ToggleNavigationButton"
                                DockPanel.Dock="Right"
                                Width="38"
                                Height="38"
                                Padding="0"
                                FontSize="16"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Collapse or expand navigation"
                                Click="ToggleNavigationButton_Click" />
                        <TextBlock x:Name="NavigationTitleText"
                                   Text="LEPTA"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="NavigationSubtitleText"
                               Text="Clipboard dashboards for parallel model responses"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="LeptaTabButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButton}"
                                 IsChecked="True"
                                 ToolTip="Open the LEPTA workspace"
                                 Checked="NavigationButton_Checked" />
                    <RadioButton x:Name="ModelsTabButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButton}"
                                 ToolTip="Open model server profiles"
                                 Checked="NavigationButton_Checked" />
                    <RadioButton x:Name="SettingsTabButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButton}"
                                 ToolTip="Open app settings"
                                 Checked="NavigationButton_Checked" />
                    <RadioButton x:Name="ChatTabButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButton}"
                                 ToolTip="Open chat"
                                 Checked="NavigationButton_Checked" />
                </StackPanel>

                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBackgroundAltBrush}"
                        BorderBrush="{DynamicResource BorderBrushTheme}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Clipboard run" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="Use the global shortcut or the workspace run button." TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid x:Name="LeptaView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="LEPTA workspace" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Panels use clipboard text plus general instructions plus each panel instruction, then generate in parallel against the selected HTTP server."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Settings"
                                    Height="36"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenSettingsFromHeaderButton_Click" />
                            <Button Content="General instructions"
                                    Height="36"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenGeneralInstructionButton_Click" />
                            <Button Content="Add panel"
                                    Height="36"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="AddLeptaPanelButton_Click" />
                            <Button x:Name="RunLeptaButton"
                                    Content="Run now"
                                    Height="36"
                                    Margin="0,0,0,8"
                                    Click="RunLeptaButton_Click" />
                        </WrapPanel>

                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
                            <StackPanel Width="220" Margin="0,0,14,12">
                                <TextBlock Text="Dashboard name" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBox x:Name="LeptaDashboardNameBox" />
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,14,12">
                                <TextBlock Text="Saved dashboards" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <ComboBox x:Name="LeptaDashboardListCombo" DisplayMemberPath="Name" SelectionChanged="LeptaDashboardListCombo_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Width="260" Margin="0,0,14,12">
                                <TextBlock Text="Target server" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <ComboBox x:Name="LeptaServerCombo" DisplayMemberPath="Name" SelectionChanged="LeptaServerCombo_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Width="200" Margin="0,0,14,12">
                                <TextBlock Text="Preset name" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBox x:Name="LeptaPresetNameBox" />
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,0,12">
                                <TextBlock Text="Saved presets" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <ComboBox x:Name="LeptaPresetListCombo" DisplayMemberPath="Name" />
                            </StackPanel>
                        </WrapPanel>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource PanelBackgroundAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrushTheme}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="General instructions" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="GeneralInstructionSummaryText"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Edit"
                                            Width="90"
                                            Height="34"
                                            Margin="16,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OpenGeneralInstructionButton_Click" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="LeptaStatusText"
                                       Grid.Row="1"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />

                            <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                                <Button Content="Save dashboard" Height="36" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Click="SaveDashboardButton_Click" />
                                <Button Content="Save dashboard as new" Height="36" Margin="0,0,12,8" Click="SaveDashboardAsNewButton_Click" />
                                <Button Content="Delete dashboard" Height="36" Margin="0,0,16,8" Style="{StaticResource SecondaryButtonStyle}" Click="DeleteDashboardButton_Click" />
                                <Button Content="Save preset" Height="36" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Click="SaveLeptaPresetButton_Click" />
                                <Button Content="Save preset as new" Height="36" Margin="0,0,8,8" Click="SaveLeptaPresetAsNewButton_Click" />
                                <Button Content="Load preset" Height="36" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Click="LoadLeptaPresetButton_Click" />
                                <Button Content="Delete preset" Height="36" Margin="0,0,0,8" Style="{StaticResource SecondaryButtonStyle}" Click="DeleteLeptaPresetButton_Click" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                        <Grid x:Name="LeptaPanelsViewport">
                            <ScrollViewer x:Name="LeptaPanelsScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <ItemsControl x:Name="LeptaPanelsItemsControl"
                                              Width="{Binding ElementName=LeptaPanelsViewport, Path=ActualWidth}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:ResponsiveUniformWrapPanel MinItemWidth="340"
                                                                                 HorizontalSpacing="16"
                                                                                 VerticalSpacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardBorderStyle}" Padding="14" MinHeight="470">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <DockPanel LastChildFill="True">
                                                        <Button DockPanel.Dock="Right"
                                                                Content="Delete"
                                                                Margin="10,0,0,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Tag="{Binding Id}"
                                                                Click="DeleteLeptaPanelButton_Click" />
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                                                            <Button Content="←" Width="34" Height="30" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding Id}" ToolTip="Move panel left" Click="MoveLeptaPanelLeftButton_Click" />
                                                            <Button Content="→" Width="34" Height="30" Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding Id}" ToolTip="Move panel right" Click="MoveLeptaPanelRightButton_Click" />
                                                        </StackPanel>
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold" />
                                                    </DockPanel>

                                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                        <TextBlock Text="Custom instruction" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <TextBox Text="{Binding CustomInstruction, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True"
                                                                 Height="96"
                                                                 TextWrapping="Wrap"
                                                                 VerticalScrollBarVisibility="Auto" />
                                                    </StackPanel>

                                                    <Border Grid.Row="2"
                                                            Margin="0,10,0,10"
                                                            Background="{DynamicResource PanelBackgroundAltBrush}"
                                                            BorderBrush="{DynamicResource BorderBrushTheme}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10,8">
                                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                                    </Border>

                                                    <TextBox Grid.Row="3"
                                                             Text="{Binding Response}"
                                                             IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <ProgressBar x:Name="LeptaProgress" Grid.Row="1" Height="6" Margin="0,10,0,0" IsIndeterminate="False" />
                </Grid>
            </Grid>

            <Grid x:Name="ModelsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Models" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Configure either an already deployed HTTP vLLM server or a LEPTA-managed Docker deployment. Docker profiles validate local settings, save compose files under %LOCALAPPDATA%\Lepta\vllm, and become available to Chat and LEPTA after /v1/models responds." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
                    <TextBlock x:Name="ModelNoteText" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Add model" Height="36" Margin="0,12,0,0" Click="AddModelButton_Click" />
                            <ListBox x:Name="ModelsList" DisplayMemberPath="Name" SelectionChanged="ModelsList_SelectionChanged" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Server configuration" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Configuration" Style="{StaticResource SecondaryButtonStyle}" Click="OpenAdvancedConfigurationButton_Click" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Name" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="ConfigurationBox_TextChanged" />
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Source" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="DeploymentModeBox" Grid.Column="1" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged">
                                    <ComboBoxItem Content="Deploy local folder with Docker" Tag="LocalDeploy" />
                                    <ComboBoxItem Content="Already deployed HTTP server" Tag="ExistingHttpServer" />
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="HTTP server" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="HttpServerAddressBox" Grid.Column="1" TextChanged="ConfigurationBox_TextChanged" />
                            </Grid>
                            <Grid Grid.Row="4" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Model / HF model ID" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="ModelBox" Grid.Column="1" TextChanged="ConfigurationBox_TextChanged" />
                            </Grid>
                            <Grid Grid.Row="5" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Served model name" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="ServedModelNameBox" Grid.Column="1" TextChanged="ConfigurationBox_TextChanged" />
                            </Grid>
                            <Grid Grid.Row="6" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Local folder" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="LocalPathBox" Grid.Column="1" TextChanged="ConfigurationBox_TextChanged" />
                                <Button Grid.Column="2" Content="Browse" Margin="10,4,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseModelButton_Click" />
                                <Button Grid.Column="3" Content="Scan metadata" Margin="10,4,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="ScanModelMetadataButton_Click" />
                            </Grid>
                            <Border Grid.Row="7" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Scanned local metadata" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="LocalModelMetadataText" Text="Select a local folder to scan metadata." TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <UniformGrid Grid.Row="8" Columns="5" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Port" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="PortBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="DType" Foreground="{DynamicResource SecondaryTextBrush}" /><ComboBox x:Name="DTypeBox" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged"><ComboBoxItem Content="half" /><ComboBoxItem Content="float16" /><ComboBoxItem Content="bfloat16" /><ComboBoxItem Content="float32" /><ComboBoxItem Content="auto" /></ComboBox></StackPanel>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="GPU memory" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="GpuBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Max len" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="MaxLenBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                <StackPanel><TextBlock Text="Swap GB" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="SwapBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                            </UniformGrid>
                            <Grid Grid.Row="9" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="KV cache dtype" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="KvCacheBox" Grid.Column="1" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged">
                                    <ComboBoxItem Content="fp8" />
                                    <ComboBoxItem Content="fp16" />
                                    <ComboBoxItem Content="bf16" />
                                </ComboBox>
                            </Grid>

                            <Border Grid.Row="10" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Estimated VRAM" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="EstimatedVramText" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Estimated RAM" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="EstimatedRamText" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="11" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,2,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="DockerStatusIndicator" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,10,0" Background="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="Docker status" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="DockerStatusText" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <TextBlock x:Name="DockerStatusDetailsText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Refresh" Width="100" Height="36" Margin="16,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshDockerStatusButton_Click" />
                                </Grid>
                            </Border>

                            <DockPanel Grid.Row="12" Margin="0,2,0,12">
                                <CheckBox x:Name="VerboseLogsCheckBox" Content="Verbose vLLM logs" VerticalAlignment="Center" Checked="VerboseLogsCheckBox_Changed" Unchecked="VerboseLogsCheckBox_Changed" />
                                <TextBlock x:Name="EstimateSummaryText" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16,0,0,0" />
                            </DockPanel>

                            <StackPanel Grid.Row="13" Orientation="Horizontal" Margin="0,8,0,14">
                                <Button Content="▶ Play" Width="110" Height="38" Click="StartServerButton_Click" />
                                <Button Content="■ Stop" Width="110" Height="38" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="StopServerButton_Click" />
                                <Button Content="↻ Restart" Width="120" Height="38" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="RestartServerButton_Click" />
                                <Button Content="Test access" Width="120" Height="38" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="TestServerButton_Click" />
                            </StackPanel>
                            <Grid Grid.Row="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ProgressBar x:Name="ModelProgress" Height="6" IsIndeterminate="False" />
                                <TextBox x:Name="DeploymentLogBox" Grid.Row="1" Margin="0,14,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Settings are saved automatically under %LOCALAPPDATA%\Lepta so your theme, defaults, hotkey, navigation layout, and overlay preferences come back on restart."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,20,0,0">
                        <StackPanel>
                            <CheckBox x:Name="DarkThemeCheckBox" Content="Enable dark theme" IsChecked="True" Margin="0,0,0,10" Checked="ThemeCheckBox_Changed" Unchecked="ThemeCheckBox_Changed" />
                            <TextBlock Text="Dark theme is enabled by default. Switch it off for a brighter UI with corrected text contrast." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Workspace defaults" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="These values control the startup layout and the default workspace/server selections that LEPTA restores automatically."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,14" />
                            <CheckBox x:Name="CollapseNavigationCheckBox"
                                      Content="Start with navigation collapsed"
                                      Margin="0,0,0,12"
                                      Checked="CollapseNavigationCheckBox_Changed"
                                      Unchecked="CollapseNavigationCheckBox_Changed" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default dashboard" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="SettingsDefaultDashboardCombo"
                                          Grid.Column="1"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="SettingsDefaultDashboardCombo_SelectionChanged" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default server" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="SettingsDefaultServerCombo"
                                          Grid.Column="1"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="SettingsDefaultServerCombo_SelectionChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Action log overlay" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Show recent actions in a transparent bottom-right overlay without interrupting the current workflow."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,12" />
                            <CheckBox x:Name="EnableActionLogOverlayCheckBox"
                                      Content="Enable action log overlay"
                                      Margin="0,0,0,10"
                                      Checked="EnableActionLogOverlayCheckBox_Changed"
                                      Unchecked="EnableActionLogOverlayCheckBox_Changed" />
                            <CheckBox x:Name="VerboseVllmLogsSettingsCheckBox"
                                      Content="Enable verbose vLLM logs"
                                      Checked="VerboseVllmLogsSettingsCheckBox_Changed"
                                      Unchecked="VerboseVllmLogsSettingsCheckBox_Changed" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Global shortcut for Lepta run" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Works even when the LEPTA window is not focused. The shortcut restores LEPTA and runs panel generation from clipboard text." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="HotkeyCtrlCheckBox" Content="Ctrl" Margin="0,0,10,0" Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed" />
                                <CheckBox x:Name="HotkeyAltCheckBox" Content="Alt" Margin="0,0,10,0" Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed" />
                                <CheckBox x:Name="HotkeyShiftCheckBox" Content="Shift" Margin="0,0,10,0" Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed" />
                                <CheckBox x:Name="HotkeyWinCheckBox" Content="Win" Margin="0,0,10,0" Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed" />
                                <ComboBox x:Name="HotkeyKeyCombo" Width="120" SelectionChanged="HotkeyKeyCombo_SelectionChanged" />
                            </StackPanel>
                            <TextBlock x:Name="HotkeyPreviewText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                            <TextBlock x:Name="HotkeyRegistrationStatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ChatView" Visibility="Collapsed">
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Chat" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Use Chat to test the selected already deployed HTTP vLLM server with streaming responses, Markdown rendering after completion, and lightweight response metadata." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock x:Name="ChatStatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,16">
                            <Button x:Name="StopChatButton" DockPanel.Dock="Right" Content="Stop" Width="110" Height="36" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="StopChatButton_Click" />
                            <Button x:Name="NewChatButton" DockPanel.Dock="Right" Content="New chat" Width="110" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="NewChatButton_Click" />
                            <ComboBox x:Name="ChatServerCombo" Width="320" DisplayMemberPath="Name" SelectionChanged="ChatServerCombo_SelectionChanged" />
                            <Button Content="Test selected" Width="110" Height="36" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="TestServerButton_Click" />
                        </DockPanel>

                        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="System instruction" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBox x:Name="ChatSystemInstructionBox"
                                         Margin="0,8,0,0"
                                         Height="88"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <TextBlock x:Name="ChatSystemInstructionHintText"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="3" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <ScrollViewer x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MessagesPanel" />
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="4" Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInputBox" MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True" PreviewKeyDown="ChatInputBox_PreviewKeyDown" />
                            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Margin="10,4,0,0" Click="SendButton_Click" />
                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Enter sends. Shift+Enter inserts a newline." />
                        </Grid>

                        <ProgressBar x:Name="ChatProgress" Grid.Row="4" Height="4" VerticalAlignment="Top" IsIndeterminate="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="ActionLogOverlayRoot"
                Grid.ColumnSpan="2"
                Panel.ZIndex="19"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <ItemsControl x:Name="ActionLogOverlayItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                Padding="12"
                                CornerRadius="12"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushTheme}"
                                BorderThickness="1"
                                MinWidth="300"
                                MaxWidth="360"
                                Opacity="0.96">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SeverityBar" CornerRadius="3" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding Source}" FontWeight="SemiBold" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding DisplayTimestamp}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="12,0,0,0" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="{x:Static sharedModels:ActionLogLevel.Info}">
                                <Setter TargetName="SeverityBar" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="{x:Static sharedModels:ActionLogLevel.Warning}">
                                <Setter TargetName="SeverityBar" Property="Background" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="{x:Static sharedModels:ActionLogLevel.Error}">
                                <Setter TargetName="SeverityBar" Property="Background" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border x:Name="GeneralInstructionPanel"
                Grid.ColumnSpan="2"
                Panel.ZIndex="20"
                Background="{DynamicResource OverlayBrush}"
                Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" MaxHeight="640">
                <Border Style="{StaticResource CardBorderStyle}" Padding="22" Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SecondaryButtonStyle}" Click="CloseGeneralInstructionButton_Click" />
                            <TextBlock Text="General instructions" FontSize="24" FontWeight="SemiBold" />
                        </DockPanel>
                        <TextBox x:Name="LeptaGeneralInstructionBox"
                                 Grid.Row="1"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="LeptaGeneralInstructionBox_TextChanged" />
                        <TextBlock Grid.Row="2"
                                   Margin="0,16,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="This instruction is combined with clipboard text and each panel's custom instruction for every LEPTA run." />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="AdvancedConfigurationPanel"
                Grid.ColumnSpan="2"
                Panel.ZIndex="21"
                Background="{DynamicResource OverlayBrush}"
                Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" MaxHeight="640">
                <Border Style="{StaticResource CardBorderStyle}" Padding="22" Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SecondaryButtonStyle}" Click="CloseAdvancedConfigurationButton_Click" />
                            <TextBlock Text="Advanced model configuration" FontSize="24" FontWeight="SemiBold" />
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,16,14"><TextBlock Text="Docker image" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="DockerImageBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Text="Parameters (model-derived)" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="4" Padding="10,9" Margin="0,4,0,0">
                                        <TextBlock x:Name="ParameterCountText" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14"><TextBlock Text="GPU layers" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="GpuLayersBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Text="Weight quantization" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="WeightQuantizationBox" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged">
                                        <ComboBoxItem Content="compressed-tensors" />
                                        <ComboBoxItem Content="AWQ" />
                                        <ComboBoxItem Content="GPTQ" />
                                        <ComboBoxItem Content="FP8" />
                                        <ComboBoxItem Content="Int8" />
                                        <ComboBoxItem Content="NF4" />
                                        <ComboBoxItem Content="Int4" />
                                        <ComboBoxItem Content="BF16" />
                                        <ComboBoxItem Content="FP16" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14"><TextBlock Text="Tensor parallel size" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="TensorParallelBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Text="K cache quantization" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="KCacheQuantizationBox" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged">
                                        <ComboBoxItem Content="fp8" />
                                        <ComboBoxItem Content="int8" />
                                        <ComboBoxItem Content="fp16" />
                                        <ComboBoxItem Content="bf16" />
                                        <ComboBoxItem Content="int4" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="V cache quantization" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="VCacheQuantizationBox" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged">
                                        <ComboBoxItem Content="fp8" />
                                        <ComboBoxItem Content="int8" />
                                        <ComboBoxItem Content="fp16" />
                                        <ComboBoxItem Content="bf16" />
                                        <ComboBoxItem Content="int4" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14"><TextBlock Text="CPU offload GB" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="CpuOffloadBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                <StackPanel Margin="0,0,0,14"><TextBlock Text="Max parallel sequences" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="MaxNumSeqsBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                            </UniformGrid>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Adjust these values similarly to LM Studio-style advanced settings. LEPTA uses them to enrich docker startup arguments and estimate memory usage." />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

