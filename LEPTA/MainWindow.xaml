<Window x:Class="LEPTA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LEPTA.Controls"
        xmlns:sharedModels="clr-namespace:LEPTA.Shared.Diagnostics;assembly=LEPTA.Shared"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="LEPTA"
        Icon="/Resources/logo_removeBG.ico"
        Height="820"
        Width="1260"
        MinHeight="720"
        MinWidth="1080">
    <Window.Resources>
        <Style x:Key="CompactIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <DataTemplate x:Key="LeptaPanelTemplate">
            <Border Background="{Binding AccentBackgroundBrush}"
                    BorderBrush="{Binding AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="4"
                    Margin="4"
                    RenderTransformOrigin="0.5,0.5"
                    Tag="{Binding Id}">
                <Grid Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource BorderBrushTheme}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,10"
                            Background="Transparent"
                            Cursor="SizeAll"
                            Tag="{Binding Id}"
                            PreviewMouseLeftButtonDown="LeptaPanelHeader_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="LeptaPanelHeader_PreviewMouseLeftButtonUp"
                            PreviewMouseMove="LeptaPanelHeader_PreviewMouseMove">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,1,12,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" />
                            <Grid Grid.Column="1"
                                  Width="34"
                                  Height="24"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  ToolTipService.InitialShowDelay="50"
                                  ToolTipService.ShowDuration="30000">
                                <Border x:Name="PanelStatusBadge"
                                        Width="20"
                                        Height="20"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundAltBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusBadgeState}" Value="Running">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusBadgeState}" Value="Success">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusBadgeState}" Value="Error">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ToolTip>
                                        <ToolTip MaxWidth="360">
                                            <TextBlock Text="{Binding StatusBadgeToolTip}"
                                                       TextWrapping="Wrap" />
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Text="{Binding StatusBadgeGlyph}"
                                               Foreground="White"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <Button Grid.Column="2"
                                    Content="Edit"
                                    Style="{StaticResource GhostToolbarButtonStyle}"
                                    Width="42"
                                    Margin="0,0,6,0"
                                    Tag="{Binding Id}"
                                    ToolTip="Edit panel name and instruction"
                                    AutomationProperties.Name="Edit panel"
                                    Click="OpenLeptaPanelEditorButton_Click" />
                            <Button Grid.Column="3"
                                    Content="×"
                                    Style="{StaticResource GhostToolbarButtonStyle}"
                                    Width="28"
                                    Tag="{Binding Id}"
                                    ToolTip="Delete this panel"
                                    AutomationProperties.Name="Delete panel"
                                    Click="DeleteLeptaPanelButton_Click" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <controls:MarkdownResponseView Text="{Binding Response}"
                                                       IsStreaming="{Binding IsStreaming}"
                                                       PanelFormat="{Binding Format}"
                                                       ResponseFontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ResponseFontSize}"
                                                       ShowChatButton="True"
                                                       Tag="{Binding Id}"
                                                       ChatRequested="LeptaPanelChatRequested"
                                                       PreviewRequested="LeptaPanelPreviewRequested" />
                        <Border Background="{DynamicResource PanelBackgroundAltBrush}"
                                BorderBrush="{DynamicResource BorderBrushTheme}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,4,0,0"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Response}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="No response yet."
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ModelServerProfileTemplate">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Width="10" Height="10" CornerRadius="5" Margin="0,5,10,0" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SecondaryTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UiStatusKind}" Value="Ready">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UiStatusKind}" Value="Busy">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UiStatusKind}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UiStatusKind}" Value="Error">
                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2"
                        Padding="8,2"
                        Margin="8,0,0,0"
                        Background="{DynamicResource PanelBackgroundAltBrush}"
                        BorderBrush="{DynamicResource BorderBrushTheme}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="{Binding UiStatusText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Grid.Row="1"
                           Margin="0,4,0,0"
                           Text="{Binding UiTypeLabel}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12" />
                <TextBlock Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Grid.Row="2"
                           Margin="0,2,0,0"
                           Text="{Binding UiEndpointLabel}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <Style x:Key="SidebarExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderBorder"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="ChevronPath"
                                      Width="8"
                                      Height="8"
                                      Margin="1,0,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Data="M 1 1 L 5 4.5 L 1 8"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      SnapsToDevicePixels="True">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" CenterX="4" CenterY="4.5" />
                                    </Path.RenderTransform>
                                </Path>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter TargetName="ChevronPath" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" CenterX="4" CenterY="4.5" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderSite"
                                              Background="{TemplateBinding Background}"
                                              Foreground="{DynamicResource SecondaryTextBrush}"
                                              Content="{TemplateBinding Header}"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Style="{StaticResource SidebarExpanderToggleStyle}" />
                                <ContentPresenter x:Name="ExpandSite"
                                                  Grid.Row="1"
                                                  Margin="0,10,0,12"
                                                  Visibility="Collapsed"
                                                  ContentSource="Content" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorChannelSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24">
                            <Border Height="4"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource PanelBackgroundAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrushTheme}"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                        BorderBrush="{DynamicResource PanelBackgroundBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="7" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="46" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="NavigationPanel" Background="{DynamicResource PanelBackgroundBrush}" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image Width="28"
                       Height="28"
                       Source="/Resources/logo_removeBG.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       ToolTip="LEPTA" />

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="LeptaTabButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButton}"
                                 IsChecked="True"
                                 ToolTip="Dashboard"
                                 ToolTipService.Placement="Mouse"
                                 ToolTipService.HorizontalOffset="18"
                                  AutomationProperties.Name="LEPTA workspace"
                                 Checked="NavigationButton_Checked" />
                    <RadioButton x:Name="ModelsTabButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButton}"
                                 ToolTip="Models"
                                 ToolTipService.Placement="Mouse"
                                 ToolTipService.HorizontalOffset="18"
                                  AutomationProperties.Name="Models"
                                 Checked="NavigationButton_Checked" />
                    <RadioButton x:Name="ChatTabButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButton}"
                                 ToolTip="Chat"
                                 ToolTipService.Placement="Mouse"
                                 ToolTipService.HorizontalOffset="18"
                                  AutomationProperties.Name="Chat"
                                 Checked="NavigationButton_Checked" />
                    <RadioButton x:Name="SettingsTabButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButton}"
                                 ToolTip="Settings"
                                 ToolTipService.Placement="Mouse"
                                 ToolTipService.HorizontalOffset="18"
                                  AutomationProperties.Name="Settings"
                                 Checked="NavigationButton_Checked" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid x:Name="LeptaView">
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="LeptaSidebarColumn" Width="320" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}">
                            <ItemsControl x:Name="LeptaPanelsItemsControl"
                                          ItemTemplate="{StaticResource LeptaPanelTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border x:Name="LeptaPanelPreviewOverlay"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource OverlayBrush}"
                                    Panel.ZIndex="18"
                                    MouseLeftButtonDown="OverlayBackdrop_MouseLeftButtonDown">
                                <Grid Margin="8">
                                    <ContentControl x:Name="LeptaPanelPreviewContent"
                                                    ContentTemplate="{StaticResource LeptaPanelTemplate}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="LeptaSidebar"
                                Grid.Column="1"
                                Background="{DynamicResource PanelBackgroundAltBrush}"
                                BorderBrush="{DynamicResource BorderBrushTheme}"
                                BorderThickness="1,0,0,0"
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          FocusVisualStyle="{x:Null}">
                                <StackPanel>
                                    <StackPanel Visibility="Collapsed">
                                        <TextBox x:Name="LeptaDashboardNameBox" Text="Workspace" />
                                        <ComboBox x:Name="LeptaDashboardListCombo"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="LeptaDashboardListCombo_SelectionChanged" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="RunLeptaButton"
                                                Grid.Column="0"
                                                Content="Run from clipboard"
                                                Height="40"
                                                MinWidth="180"
                                                ToolTip="Run the active dashboard against the clipboard text"
                                                AutomationProperties.Name="Run LEPTA workspace"
                                                Click="RunLeptaButton_Click" />
                                        <Button x:Name="StopLeptaButton"
                                                Grid.Column="2"
                                                Content="Stop"
                                                Height="40"
                                                MinWidth="108"
                                                Padding="18,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Cancel the active LEPTA request"
                                                AutomationProperties.Name="Stop LEPTA request"
                                                Click="StopLeptaButton_Click" />
                                    </Grid>
                                    <TextBlock x:Name="LeptaRunHotkeyText"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,14" />

                                    <Expander Header="Panel control"
                                              Style="{StaticResource SidebarExpanderStyle}"
                                              IsExpanded="False"
                                              Margin="0,0,0,12">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="Preset name" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBox x:Name="LeptaPresetNameBox" />
                                            <TextBlock Text="Saved presets" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                                            <ComboBox x:Name="LeptaPresetListCombo"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectionChanged="LeptaPresetListCombo_SelectionChanged" />
                                            <UniformGrid Columns="4" Margin="0,8,0,0">
                                                <Button Content="Save"
                                                        Height="34"
                                                        Margin="0,0,8,0"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Click="SaveLeptaPresetButton_Click" />
                                                <Button Content="New"
                                                        Height="34"
                                                        Margin="0,0,8,0"
                                                        Click="SaveLeptaPresetAsNewButton_Click" />
                                                <Button Content="Load"
                                                        Height="34"
                                                        Margin="0,0,8,0"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Click="LoadLeptaPresetButton_Click" />
                                                <Button Content="Delete"
                                                        Height="34"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Click="DeleteLeptaPresetButton_Click" />
                                            </UniformGrid>

                                            <Button Content="+ Add panel"
                                                    Height="36"
                                                    Margin="0,12,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="AddLeptaPanelButton_Click" />

                                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushTheme}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12"
                                                    Margin="0,12,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Global instructions" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <TextBlock x:Name="GeneralInstructionSummaryText"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,6,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Edit"
                                                            Width="80"
                                                            Height="34"
                                                            Margin="12,0,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="OpenGeneralInstructionButton_Click" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="Model"
                                              Style="{StaticResource SidebarExpanderStyle}"
                                              IsExpanded="False"
                                              Margin="0,0,0,12">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="Available model" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <ComboBox x:Name="LeptaServerCombo"
                                                      DisplayMemberPath="Name"
                                                      SelectionChanged="LeptaServerCombo_SelectionChanged" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="Request settings"
                                              Style="{StaticResource SidebarExpanderStyle}"
                                              IsExpanded="False"
                                              Margin="0,0,0,12">
                                        <StackPanel Margin="0,12,0,0">
                                            <CheckBox x:Name="LeptaThinkingCheckBox"
                                                      Content="Enable thinking when supported" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Temperature"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBox x:Name="LeptaTemperatureBox"
                                                         Grid.Column="1"
                                                         ToolTip="0 is more deterministic, 2 is more exploratory." />
                                            </Grid>
                                            <TextBlock Text="0.00 to 2.00. Lower values are steadier; higher values allow more variation."
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="Performance"
                                              Style="{StaticResource SidebarExpanderStyle}"
                                              IsExpanded="False">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock x:Name="LeptaThroughputValueText"
                                                       Visibility="Collapsed" />
                                            <ProgressBar x:Name="LeptaProgress"
                                                         Height="6"
                                                         Margin="0,0,0,0"
                                                         IsIndeterminate="False" />
                                            <Border x:Name="LeptaThroughputGraphHost"
                                                    Height="142"
                                                    Margin="0,12,0,0"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushTheme}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    SizeChanged="LeptaThroughputGraphHost_SizeChanged"
                                                    MouseMove="LeptaThroughputGraphHost_MouseMove"
                                                    MouseLeave="LeptaThroughputGraphHost_MouseLeave">
                                                 <Canvas x:Name="LeptaThroughputCanvas" Margin="4" ClipToBounds="True">
                                                </Canvas>
                                            </Border>
                                            <TextBlock x:Name="LeptaThroughputDetailsText"
                                                       Margin="0,10,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="LeptaStatusText"
                                                       Margin="0,10,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Button x:Name="ToggleLeptaSidebarButton"
                                Grid.Column="0"
                                Panel.ZIndex="5"
                                Width="18"
                                Height="34"
                                Padding="0"
                                Margin="0,0,-9,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ToggleLeptaSidebarButton_Click">></Button>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ModelsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Models" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}">
                            Configure an HTTP vLLM server (local or cloud, e.g. OpenRouter) or a LEPTA-managed Docker deployment.
                            Docker profiles validate settings, save compose files under %LOCALAPPDATA%\Lepta\vllm, and become
                            available to Chat and LEPTA only after /v1/models responds.
                        </TextBlock>
                        <TextBlock x:Name="ModelNoteText" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="+ Add model" Height="38" Margin="0,12,0,0" Click="AddModelButton_Click" />
                            <Grid>
                                <ListBox x:Name="ModelsList" ItemTemplate="{StaticResource ModelServerProfileTemplate}" SelectionChanged="ModelsList_SelectionChanged" PreviewMouseLeftButtonDown="ModelsList_PreviewMouseLeftButtonDown" />
                                <Border Background="{DynamicResource PanelBackgroundAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrushTheme}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="4"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ModelsList, Path=HasItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="No model server profiles yet. Add a profile to configure an existing HTTP server or a Docker-managed local deployment." />
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <ScrollViewer x:Name="ConfigurationScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ModelConfigurationTitleText" Text="Server configuration" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="SaveModelButton" Content="Save" MinWidth="80" Style="{StaticResource SecondaryButtonStyle}" Click="SaveModelButton_Click" />
                                        <Button x:Name="DeleteModelButton" Content="Delete" MinWidth="80" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="DeleteModelButton_Click" />
                                        <Button x:Name="CheckServerButton" Content="Check server" MinWidth="90" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="CheckServerButton_Click" />
                                        <Button x:Name="OpenAdvancedConfigurationButton" Margin="8,0,0,0" Content="Advanced" MinWidth="90" Style="{StaticResource SecondaryButtonStyle}" Click="OpenAdvancedConfigurationButton_Click" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Name" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                            <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="ConfigurationBox_TextChanged" />
                                        </Grid>
                                        <Grid x:Name="HttpServerRow" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="HTTP server" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                            <TextBox x:Name="HttpServerAddressBox" Grid.Column="1" TextChanged="ConfigurationBox_TextChanged" />
                                        </Grid>
                                        <Grid x:Name="ApiKeyRow" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="API key" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <Grid Margin="0,2,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" />
                                                    <TextBox x:Name="ApiKeyRevealBox" Grid.Column="0" Visibility="Collapsed" TextChanged="ApiKeyRevealBox_TextChanged" />
                                                    <CheckBox x:Name="ApiKeyRevealCheckBox" Grid.Column="1" Content="Show" Margin="8,0,0,0" VerticalAlignment="Center"
                                                              Foreground="{DynamicResource SecondaryTextBrush}" Checked="ApiKeyRevealCheckBox_Changed" Unchecked="ApiKeyRevealCheckBox_Changed" />
                                                </Grid>

                                                <TextBlock Text="Authentication header" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text="Where the API key is sent. Most providers use the default (Authorization: Bearer). Azure uses header name &quot;api-key&quot;; some gateways use &quot;X-API-Key&quot;."
                                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Header name" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Grid.Column="2" Text="Scheme (Authorization only)" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBox x:Name="AuthHeaderNameBox" Grid.Row="1" Grid.Column="0" TextChanged="ConfigurationBox_TextChanged" />
                                                    <TextBox x:Name="AuthHeaderSchemeBox" Grid.Row="1" Grid.Column="2" TextChanged="ConfigurationBox_TextChanged" />
                                                </Grid>

                                                <TextBlock Text="Extra HTTP headers (optional)" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text="One per line, as Name: Value. Leave empty if your provider only needs the API key."
                                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                                <TextBox x:Name="ExtraHeadersBox" AcceptsReturn="True" Height="60" Margin="0,0,0,8" VerticalScrollBarVisibility="Auto"
                                                         TextChanged="ConfigurationBox_TextChanged" />

                                                <TextBlock Text="Extra JSON body fields (optional)" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text="A JSON object merged into every request body, e.g. {&quot;user&quot;:&quot;user-123&quot;}. Leave empty if not needed."
                                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                                <TextBox x:Name="ExtraBodyBox" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"
                                                         TextChanged="ConfigurationBox_TextChanged" />
                                                <TextBlock x:Name="RequestOverridesErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                            </StackPanel>
                                            <TextBlock Text="Authentication" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                        </Grid>
                                        <Grid x:Name="ServedModelsRow" Margin="0,0,0,10" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Served models" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <ComboBox x:Name="ServedModelsCombo" SelectionChanged="ServedModelsCombo_SelectionChanged"
                                                          ToolTip="Models reported by /v1/models. Choose one to use it as the model name." />
                                                <TextBlock x:Name="ServedModelsHintText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"
                                                           Text="Use Check server to list the models this server serves." TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid x:Name="ServedModelNameRow">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ServedModelNameLabelText" Text="Served model name" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                            <TextBox x:Name="ServedModelNameBox" Grid.Column="1" TextChanged="ConfigurationBox_TextChanged" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Source" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                            <ComboBox x:Name="DeploymentModeBox" Grid.Column="1" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged">
                                                <ComboBoxItem Content="Deploy local folder with Docker" Tag="LocalDeploy" />
                                                <ComboBoxItem Content="Already deployed HTTP server" Tag="ExistingHttpServer" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ModelFieldLabelText" Text="Model / HF model ID" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                            <TextBox x:Name="ModelBox" Grid.Column="1" TextChanged="ConfigurationBox_TextChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="LocalFolderRow" Grid.Row="2" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Local folder" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBox x:Name="LocalPathBox" Grid.Column="1" TextChanged="ConfigurationBox_TextChanged" />
                                    <Button Grid.Column="2" Content="Browse" Margin="10,4,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseModelButton_Click" />
                                    <Button Grid.Column="3" Content="Scan metadata" Margin="10,4,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="ScanModelMetadataButton_Click" />
                                </Grid>

                                <Border x:Name="LocalMetadataBorder" Grid.Row="3" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Suitable local folders are vLLM-compatible Hugging Face Transformers directories. They can come from Hugging Face or another source, as long as the folder contains config/tokenizer files and model weights. GGUF bundles are not suitable for this Docker flow."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="Scanned local metadata" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="LocalModelMetadataText" Text="Select a local vLLM-compatible Hugging Face-style folder to scan metadata." TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="4" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Border x:Name="LocalRuntimeSettingsPanel" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Runtime" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" />
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10"><TextBlock Text="Max len" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="MaxLenBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="Port" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="PortBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10"><TextBlock Text="DType" Foreground="{DynamicResource SecondaryTextBrush}" /><ComboBox x:Name="DTypeBox" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged"><ComboBoxItem Content="half" /><ComboBoxItem Content="float16" /><ComboBoxItem Content="bfloat16" /><ComboBoxItem Content="float32" /><ComboBoxItem Content="auto" /></ComboBox></StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="GPU memory util." Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="GpuBox" PreviewTextInput="DecimalBox_PreviewTextInput" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="GPU VRAM GB" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="GpuVramBox" PreviewTextInput="DecimalBox_PreviewTextInput" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="4"><TextBlock Text="CPU offload GB" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="CpuOffloadBox" ToolTip="Host RAM budget vLLM can use for CPU offload." PreviewTextInput="DecimalBox_PreviewTextInput" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0"><TextBlock Text="Ready timeout min" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="ReadyTimeoutBox" ToolTip="How long LEPTA waits for /v1/models after Docker starts." TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="EstimateBorder" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Minimum required GPU usage" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock x:Name="EstimatedVramText" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <Border x:Name="DockerStatusBorder" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="DockerStatusIndicator" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,10,0" Background="{DynamicResource SecondaryTextBrush}" />
                                                        <TextBlock Text="Docker status" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="DockerStatusText" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                    <TextBlock x:Name="DockerStatusDetailsText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Refresh" Width="100" Height="36" Margin="16,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshDockerStatusButton_Click" />
                                            </Grid>
                                        </Border>

                                        <Border x:Name="ModelActionsBorder" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Model actions" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="StartServerButton" Grid.Column="0" Content="Run server" Height="40" ToolTip="Start the selected LEPTA-managed local server" AutomationProperties.Name="Start server" Click="StartServerButton_Click" />
                                                    <Button x:Name="StopServerButton" Grid.Column="2" Content="Stop server" Height="40" ToolTip="Stop the selected LEPTA-managed server" AutomationProperties.Name="Stop server" Style="{StaticResource SecondaryButtonStyle}" Click="StopServerButton_Click" />
                                                    <Button x:Name="RestartServerButton" Grid.Column="4" Content="Restart server" Height="40" ToolTip="Restart the selected LEPTA-managed server" AutomationProperties.Name="Restart server" Style="{StaticResource SecondaryButtonStyle}" Click="RestartServerButton_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="DeploymentLogBorder" Grid.Row="5" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Server log" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                            <CheckBox x:Name="VerboseLogsCheckBox" Grid.Column="1" Content="Verbose vLLM logs" VerticalAlignment="Center" Checked="VerboseLogsCheckBox_Changed" Unchecked="VerboseLogsCheckBox_Changed" />
                                        </Grid>
                                        <TextBox x:Name="DeploymentLogBox"
                                                 Margin="0,10,0,0"
                                                 Height="180"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Border>

                                <DockPanel Grid.Row="6" Margin="0,2,0,12">
                                    <TextBlock x:Name="EstimateSummaryText" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>

                                <ProgressBar x:Name="ModelProgress" Grid.Row="7" Height="6" IsIndeterminate="False" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Settings are saved automatically under %LOCALAPPDATA%\Lepta so your theme, font size, defaults, hotkey, and overlay preferences come back on restart."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,20,0,0">
                        <StackPanel>
                            <CheckBox x:Name="DarkThemeCheckBox" Content="Enable dark theme" IsChecked="True" Margin="0,0,0,10" Checked="ThemeCheckBox_Changed" Unchecked="ThemeCheckBox_Changed" />
                            <TextBlock Text="Dark theme is enabled by default. Switch it off for a brighter UI with corrected text contrast." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Workspace defaults" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="These values control the app font size and the default server selection that LEPTA restores automatically."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,14" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Font size" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="UiFontSizeCombo"
                                          Grid.Column="1"
                                          SelectionChanged="UiFontSizeCombo_SelectionChanged">
                                    <ComboBoxItem Content="12" />
                                    <ComboBoxItem Content="13" />
                                    <ComboBoxItem Content="14" />
                                    <ComboBoxItem Content="15" />
                                    <ComboBoxItem Content="16" />
                                    <ComboBoxItem Content="18" />
                                </ComboBox>
                            </Grid>
                             <Grid Margin="0,0,0,12">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="180" />
                                     <ColumnDefinition Width="*" />
                                 </Grid.ColumnDefinitions>
                                 <TextBlock Text="Response font size" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                 <ComboBox x:Name="ResponseFontSizeCombo"
                                           Grid.Column="1"
                                           SelectionChanged="ResponseFontSizeCombo_SelectionChanged">
                                     <ComboBoxItem Content="4" />
                                     <ComboBoxItem Content="6" />
                                     <ComboBoxItem Content="8" />
                                     <ComboBoxItem Content="10" />
                                     <ComboBoxItem Content="12" />
                                     <ComboBoxItem Content="14" />
                                     <ComboBoxItem Content="16" />
                                     <ComboBoxItem Content="18" />
                                     <ComboBoxItem Content="20" />
                                     <ComboBoxItem Content="22" />
                                     <ComboBoxItem Content="24" />
                                 </ComboBox>
                             </Grid>
                             <TextBlock Text="Tip: hold Ctrl and use the mouse wheel over any rendered response to change Markdown and Mermaid response size."
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        TextWrapping="Wrap"
                                        Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default server" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="SettingsDefaultServerCombo"
                                          Grid.Column="1"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="SettingsDefaultServerCombo_SelectionChanged" />
                            </Grid>
                            <StackPanel Visibility="Collapsed">
                                <ComboBox x:Name="SettingsDefaultDashboardCombo"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="SettingsDefaultDashboardCombo_SelectionChanged" />
                                <CheckBox x:Name="CollapseNavigationCheckBox"
                                          Checked="CollapseNavigationCheckBox_Changed"
                                          Unchecked="CollapseNavigationCheckBox_Changed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Clipboard cache prefill" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="When new text lands in the clipboard, LEPTA can send a tiny 32-token prefill request with the system instructions, global instructions, and clipboard text to warm the KV cache before you press Run."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,12" />
                            <CheckBox x:Name="EnableClipboardCachePrefillCheckBox"
                                      Content="Enable clipboard cache prefill"
                                      Checked="EnableClipboardCachePrefillCheckBox_Changed"
                                      Unchecked="EnableClipboardCachePrefillCheckBox_Changed" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="LEPTA system instructions" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Each LEPTA panel request is assembled in this order: System Instructions from this field, Global Instructions from the LEPTA workspace, Text from the clipboard, Panel Instructions from the panel, then the model writes the Response. This value is saved under %LOCALAPPDATA%\Lepta and restored on restart."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,12" />
                            <TextBox x:Name="LeptaSystemInstructionBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="180"
                                     TextChanged="LeptaSystemInstructionBox_TextChanged" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="LEPTA document trimming" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Set how many document tokens LEPTA keeps for each request, then choose whether it removes the oldest text from the start or cuts off the overflow at the end when the clipboard content is too large."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,12" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Document token limit" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="LeptaDocumentTokenLimitBox"
                                         Grid.Column="1"
                                         TextChanged="LeptaDocumentTokenLimitBox_TextChanged" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Trim direction" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="LeptaDocumentTrimModeCombo"
                                          Grid.Column="1"
                                          SelectionChanged="LeptaDocumentTrimModeCombo_SelectionChanged">
                                    <ComboBoxItem Tag="TrimStart" Content="Trim start (keep newest text)" />
                                    <ComboBoxItem Tag="TrimEnd" Content="Trim end (keep earliest text)" />
                                </ComboBox>
                            </Grid>
                            <TextBlock x:Name="LeptaDocumentTrimSummaryText"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Action log overlay" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Show recent actions in a transparent bottom-right overlay without interrupting the current workflow."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,12" />
                            <CheckBox x:Name="EnableActionLogOverlayCheckBox"
                                      Content="Enable action log overlay"
                                      Margin="0,0,0,10"
                                      Checked="EnableActionLogOverlayCheckBox_Changed"
                                      Unchecked="EnableActionLogOverlayCheckBox_Changed" />
                            <CheckBox x:Name="VerboseVllmLogsSettingsCheckBox"
                                      Content="Enable verbose vLLM logs"
                                      Checked="VerboseVllmLogsSettingsCheckBox_Changed"
                                      Unchecked="VerboseVllmLogsSettingsCheckBox_Changed" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Global shortcut for Lepta run" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Works even when the LEPTA window is not focused. The shortcut restores LEPTA and runs panel generation from clipboard text." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="HotkeyCtrlCheckBox" Content="Ctrl" Margin="0,0,10,0" Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed" />
                                <CheckBox x:Name="HotkeyAltCheckBox" Content="Alt" Margin="0,0,10,0" Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed" />
                                <CheckBox x:Name="HotkeyShiftCheckBox" Content="Shift" Margin="0,0,10,0" Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed" />
                                <CheckBox x:Name="HotkeyWinCheckBox" Content="Win" Margin="0,0,10,0" Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed" />
                                <ComboBox x:Name="HotkeyKeyCombo" Width="120" IsEditable="True" IsTextSearchEnabled="False" SelectionChanged="HotkeyKeyCombo_SelectionChanged" />
                            </StackPanel>
                            <TextBlock x:Name="HotkeyPreviewText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                            <TextBlock x:Name="HotkeyRegistrationStatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ChatView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="ChatHistoryColumn" Width="280" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource PanelBackgroundAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="ChatServerCombo"
                                              Width="320"
                                              Height="34"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="ChatServerCombo_SelectionChanged" />
                                    <CheckBox x:Name="ChatThinkingCheckBox"
                                              Content="Thinking"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center" />
                                    <Button x:Name="NewChatButton"
                                            Content="New chat"
                                            Height="34"
                                            Padding="14,0"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="NewChatButton_Click" />
                                    <Button x:Name="StopChatButton"
                                            Content="Stop"
                                            Height="34"
                                            Padding="14,0"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="StopChatButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="ChatStatusText"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundAltBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid>
                                <ScrollViewer x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="MessagesPanel" />
                                </ScrollViewer>
                                <Border x:Name="ChatEmptyStateBorder"
                                        Background="{DynamicResource PanelBackgroundAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrushTheme}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="18"
                                        Margin="2"
                                        IsHitTestVisible="False">
                                    <StackPanel>
                                        <TextBlock Text="Chat is ready" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="Select a verified server and send a prompt to start." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInputBox" MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True" PreviewKeyDown="ChatInputBox_PreviewKeyDown" />
                            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Margin="10,4,0,0" Click="SendButton_Click" />
                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Enter sends; Shift+Enter adds a newline." />
                        </Grid>

                        <ProgressBar x:Name="ChatProgress" Height="4" VerticalAlignment="Top" IsIndeterminate="False" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Margin="12,0,0,0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="History" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,12" />
                        <ListBox x:Name="ChatHistoryList"
                                 Grid.Row="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="False"
                                 SelectionChanged="ChatHistoryList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,6,6,6" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Row="0" Grid.Column="1"
                                                    Content="✕"
                                                    Width="24" Height="24"
                                                    Padding="0"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Margin="6,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DeleteHistoryEntry_Click"
                                                    ToolTip="Delete this chat" />
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                                       Text="{Binding CreatedAt, StringFormat={}{0:MMM dd, HH:mm}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="ActionLogOverlayRoot"
                Grid.ColumnSpan="2"
                Panel.ZIndex="19"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <ItemsControl x:Name="ActionLogOverlayItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                Padding="12"
                                CornerRadius="12"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushTheme}"
                                BorderThickness="1"
                                MinWidth="300"
                                MaxWidth="360"
                                Opacity="0.96">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SeverityBar" CornerRadius="3" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding Source}" FontWeight="SemiBold" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding DisplayTimestamp}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="12,0,0,0" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="{x:Static sharedModels:ActionLogLevel.Info}">
                                <Setter TargetName="SeverityBar" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="{x:Static sharedModels:ActionLogLevel.Warning}">
                                <Setter TargetName="SeverityBar" Property="Background" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="{x:Static sharedModels:ActionLogLevel.Error}">
                                <Setter TargetName="SeverityBar" Property="Background" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border x:Name="GeneralInstructionPanel"
                Grid.ColumnSpan="2"
                Panel.ZIndex="20"
                Background="{DynamicResource OverlayBrush}"
                MouseLeftButtonDown="OverlayBackdrop_MouseLeftButtonDown"
                Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" MaxHeight="640">
                <Border Style="{StaticResource CardBorderStyle}" Padding="22" Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Global instructions" FontSize="24" FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    Content="Close"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CloseGeneralInstructionButton_Click" />
                        </Grid>
                        <TextBox x:Name="LeptaGeneralInstructionBox"
                                 Grid.Row="1"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="LeptaGeneralInstructionBox_TextChanged" />

                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="LeptaPanelEditorPanel"
                Grid.ColumnSpan="2"
                Panel.ZIndex="21"
                Background="{DynamicResource OverlayBrush}"
                MouseLeftButtonDown="OverlayBackdrop_MouseLeftButtonDown"
                Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" MaxHeight="640">
                <Border Style="{StaticResource CardBorderStyle}" Padding="22" Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LeptaPanelEditorTitleText" Text="Edit panel" FontSize="24" FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    Content="Close"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CloseLeptaPanelEditorButton_Click" />
                        </Grid>
                                      <ScrollViewer Grid.Row="1"
                                                    VerticalScrollBarVisibility="Auto"
                                                    CanContentScroll="True">
                                          <StackPanel Margin="0,0,4,0">
                                              <TextBlock Text="Panel name" Foreground="{DynamicResource SecondaryTextBrush}" />
                                              <TextBox x:Name="LeptaPanelEditorNameBox"
                                                       Margin="0,0,0,14"
                                                       TextChanged="LeptaPanelEditorNameBox_TextChanged" />
                                              <TextBlock Text="Panel format" Foreground="{DynamicResource SecondaryTextBrush}" />
                                              <ComboBox x:Name="LeptaPanelEditorFormatCombo"
                                                        Margin="0,6,0,14"
                                                        SelectionChanged="LeptaPanelEditorFormatCombo_SelectionChanged" />
                            <TextBlock Text="Request instruction" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox x:Name="LeptaPanelEditorInstructionBox"
                                                   Margin="0,6,0,14"
                                     AcceptsReturn="True"
                                                   MinHeight="200"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="LeptaPanelEditorInstructionBox_TextChanged" />
                                              <TextBlock Text="Panel border color" Foreground="{DynamicResource SecondaryTextBrush}" />
                                              <TextBlock Text="Choose one of the preset colors or paste a hex color." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                              <Grid Margin="0,8,0,0">
                                                  <Grid.ColumnDefinitions>
                                                      <ColumnDefinition Width="28" />
                                                      <ColumnDefinition Width="10" />
                                                      <ColumnDefinition Width="*" />
                                                  </Grid.ColumnDefinitions>
                                                  <Border x:Name="LeptaPanelColorPreviewBorder"
                                                          Grid.Column="0"
                                                          Height="28"
                                                          Width="28"
                                                          CornerRadius="8"
                                                          BorderBrush="{DynamicResource BorderBrushTheme}"
                                                          BorderThickness="1" />
                                                  <TextBox x:Name="LeptaPanelColorHexBox"
                                                           Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           MaxLength="7"
                                                           TextChanged="LeptaPanelColorHexBox_TextChanged" />
                                              </Grid>
                                                <WrapPanel x:Name="LeptaPanelColorOptionsGrid"
                                                           Margin="0,8,0,0"
                                                           HorizontalAlignment="Left" />
                                          </StackPanel>
                                      </ScrollViewer>
                                      <DockPanel Grid.Row="2" Margin="0,16,0,0">
                            <Button DockPanel.Dock="Right"
                                    Content="Delete panel"
                                    Width="120"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DeleteLeptaPanelFromEditorButton_Click" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="AdvancedConfigurationPanel"
                Grid.ColumnSpan="2"
                Panel.ZIndex="22"
                Background="{DynamicResource OverlayBrush}"
                MouseLeftButtonDown="OverlayBackdrop_MouseLeftButtonDown"
                Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" MaxHeight="640">
                <Border Style="{StaticResource CardBorderStyle}" Padding="22" Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Advanced model configuration" FontSize="24" FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    Content="Close"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CloseAdvancedConfigurationButton_Click" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,16,14"><TextBlock Text="Docker image" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="DockerImageBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Text="Parameters (model-derived)" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="4" Padding="10,9" Margin="0,4,0,0">
                                        <TextBlock x:Name="ParameterCountText" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Text="Weight quantization" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="WeightQuantizationBox" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged">
                                        <ComboBoxItem Content="compressed-tensors" />
                                        <ComboBoxItem Content="AWQ" />
                                        <ComboBoxItem Content="GPTQ" />
                                        <ComboBoxItem Content="FP8" />
                                        <ComboBoxItem Content="Int8" />
                                        <ComboBoxItem Content="NF4" />
                                        <ComboBoxItem Content="Int4" />
                                        <ComboBoxItem Content="BF16" />
                                        <ComboBoxItem Content="FP16" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14"><TextBlock Text="Tensor parallel size" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="TensorParallelBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Text="K cache quantization" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="KCacheQuantizationBox" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged">
                                        <ComboBoxItem Content="fp8" />
                                        <ComboBoxItem Content="int8" />
                                        <ComboBoxItem Content="fp16" />
                                        <ComboBoxItem Content="bf16" />
                                        <ComboBoxItem Content="int4" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="V cache quantization" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="VCacheQuantizationBox" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged">
                                        <ComboBoxItem Content="fp8" />
                                        <ComboBoxItem Content="int8" />
                                        <ComboBoxItem Content="fp16" />
                                        <ComboBoxItem Content="bf16" />
                                        <ComboBoxItem Content="int4" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Text="Tokenizers parallelism" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="TokenizersParallelismBox" Margin="0,4,0,0" SelectionChanged="ConfigurationSelectionChanged">
                                        <ComboBoxItem Content="true" />
                                        <ComboBoxItem Content="false" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14"><TextBlock Text="Max parallel sequences" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="MaxNumSeqsBox" TextChanged="ConfigurationBox_TextChanged" /></StackPanel>
                                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
                                    <TextBlock Text="Append extra vLLM flags" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBox x:Name="AdditionalVllmArgumentsBox"
                                             Margin="0,4,0,0"
                                             MinHeight="56"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="--speculative-config '{&quot;method&quot;:&quot;qwen3_next_mtp&quot;,&quot;num_speculative_tokens&quot;:2}'"
                                             TextChanged="ConfigurationBox_TextChanged" />
                                    <TextBlock Text="These tokens are appended after LEPTA's generated vLLM arguments. The default targets Qwen MTP speculative decoding, and you can edit or clear it for other models."
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="LEPTA generates a compose file, Dockerfile, and entrypoint script from these values. The env-driven vLLM settings mirror the dev stack while keeping model-specific arguments in the generated script." />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

